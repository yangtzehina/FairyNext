<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>FairyNext.Compiler</RootNamespace>
    <!-- 编译器 = 无头运行时（承诺 8）：本工程引用 Core，.fui→FGB 的布局/排序/烘焙全部经真运行时代码路径产出。
         netstandard2.1 使其可被 Unity 编辑器进程内引用（JIT 预览）；CLI 壳后续以 net9.0 console 包装。 -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/FairyNext.Core.csproj" />
    <!-- .fui 前端（M1-12）：ByteBuffer.ReadColor 出 Numerics 的 Color32，包身份 sourceHash 走 FnvHash。
         经 Core 传递也拿得到，写明是因为前端**直接**依赖它，不该靠别人的引用面活着。 -->
    <ProjectReference Include="../Numerics/FairyNext.Numerics.csproj" />
    <!-- FGB 写入器（M1-19）：头/目录偏移与段 fourcc 直读 AbiLayout/Abi——同一条「直接依赖写明」纪律。 -->
    <ProjectReference Include="../Contracts/FairyNext.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- M1-20a：关系翻译表/组归属规划是内部件，其 golden/负例（含约束环拒绝的合成语料——
         真实样例包不带环）要能直取内部面；与 Core 同款开放口径。 -->
    <InternalsVisibleTo Include="FairyNext.Tests" />
  </ItemGroup>
</Project>
